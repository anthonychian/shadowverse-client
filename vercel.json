{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/decks/:id", "destination": "/api/deck-share?id=:id" }
  ],
  "headers": [
    {
      "source": "/(textures|atlases|assets|static)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/shadowverse.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
