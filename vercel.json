{
  "$schema": "https://vercel.sh",
  "rewrites": [
    { "source": "/decks/:id", "destination": "/api/deck-share?id=:id" }
  ],
  "headers": [
    {
      "source": "/(textures|atlases|assets|static)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/shadowverse.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "images": {
    "sizes": [64, 186, 459],
    "domains": ["pub-d07230ffd5624f6981ebb2918a780b6b.r2.dev"],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 31536000
  }
}
